# =============================================================================
# Arbetsström 3 — Riksdagens öppna data API
# Konfigurationsmall: kopiera till .env och fyll i dina värden
# .env ska aldrig checkas in i Git
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Bas-URL för riksdagens API (ändras bara om API:et byter adress)
RIKSDAG_API_BASE=https://data.riksdagen.se

# Antal träffar per API-anrop (max 100 stöds av API:et)
RIKSDAG_PAGE_SIZE=20

# -----------------------------------------------------------------------------
# Lokal RAG-cache
# -----------------------------------------------------------------------------

# Databasanslutning för chunks och embeddings
# PostgreSQL med pgvector:
DATABASE_URL=postgresql://mitt_db_anvandare:byt_till_eget_starkt_losenord@localhost:5432/riksdag
# SQLite med sqlite-vec:
# DATABASE_URL=sqlite:///riksdag_api.db

# Storlekstak för RAG-cachen i GB (LRU-eviction vid överskridande)
# Vägledning: 2 = normalt bruk, 5–10 = tungt bruk, 20+ = systematisk genomgång
CACHE_MAX_SIZE_GB=2

# Cache-TTL i dagar för dokument från innevarande riksmöte
# Dokument från tidigare riksmöten cachas permanent (de ändras aldrig)
CACHE_TTL_AKTUELLT_RIKSMOTE_DAGAR=7
# Gammalt variabelnamn (v2.x): CACHE_TTL_CURRENT_SESSION_DAYS — stöds fortfarande

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------

# Modell för semantisk sökning på svenska
# KBLab/sentence-bert-swedish-cased är tränad specifikt för sentence similarity
EMBEDDING_MODELL=KBLab/sentence-bert-swedish-cased
# Gammalt variabelnamn (v2.x): EMBEDDING_MODEL — stöds fortfarande

# -----------------------------------------------------------------------------
# MCP-transport
# -----------------------------------------------------------------------------

# Transportläge: stdio (standard, lokal) eller http (hostad driftsättning)
MCP_TRANSPORT=stdio

# HTTP-transport: adress och port (används bara när MCP_TRANSPORT=http)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# API-nyckel för Bearer-token-autentisering i HTTP-läget.
# Generera med: python3 -c "import secrets; print(secrets.token_hex(32))"
# Lämna tom för att köra utan autentisering (rekommenderas inte i produktion).
MCP_API_KEY=

# -----------------------------------------------------------------------------
# Engångsmigration (riksdag_rag → riksdagstryck)
# Används bara av migrate_to_riksdagstryck.py — behövs inte i normal drift
# -----------------------------------------------------------------------------

# PostgreSQL-URL till källdatabasen som ska migreras från
RIKSDAG_DB_URL_KALLA=postgresql://<ANVANDARE>:<LOSENORD>@localhost:5432/riksdag_rag

# PostgreSQL-URL till måldatabasen som ska migreras till
RIKSDAG_DB_URL_MAL=postgresql://<ANVANDARE>:<LOSENORD>@localhost:5432/riksdagstryck

# -----------------------------------------------------------------------------
# SOU-flaggor
# -----------------------------------------------------------------------------

# Aktivera/inaktivera SOU-sökning (rd_search med doktyp="sou")
# Sätt till false om liu-sou-servern (ström 4) hanterar SOU-sökning
# i din installation — undviker att SOU-sökningar dupliceras.
SOU_SOKNING_AKTIV=true

# Aktivera/inaktivera SOU-hämtning och RAG-indexering (rd_get_document för SOU)
# Sätt till false om liu-sou-servern (ström 4) hanterar SOU-fulltext
# i din installation — undviker att SOU-fulltext lagras i två databaser.
SOU_HAMTNING_AKTIV=true
