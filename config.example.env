# =============================================================================
# Arbetsström 3 — Riksdagens öppna data API
# Konfigurationsmall: kopiera till .env och fyll i dina värden
# .env ska aldrig checkas in i Git
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Bas-URL för riksdagens API (ändras bara om API:et byter adress)
RIKSDAG_API_BASE=https://data.riksdagen.se

# Antal träffar per API-anrop (max 100 stöds av API:et)
RIKSDAG_PAGE_SIZE=20

# -----------------------------------------------------------------------------
# Lokal RAG-cache
# -----------------------------------------------------------------------------

# Databasanslutning för chunks och embeddings
# SQLite (enklare, ingen serverinstallation):
DATABASE_URL=sqlite:///riksdag_rag.db
# PostgreSQL med pgvector (bättre prestanda vid stora volymer):
# DATABASE_URL=postgresql://user:password@localhost/riksdag_rag

# Storlekstak för RAG-cachen i GB (LRU-eviction vid överskridande)
# Vägledning: 2 = normalt bruk, 5–10 = tungt bruk, 20+ = systematisk genomgång
CACHE_MAX_SIZE_GB=2

# Cache-TTL i dagar för dokument från innevarande riksmöte
# Dokument från tidigare riksmöten cachas permanent (de ändras aldrig)
CACHE_TTL_CURRENT_SESSION_DAYS=7

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------

# Modell för semantisk sökning på svenska
# KBLab/sentence-bert-swedish-cased är tränad specifikt för sentence similarity
EMBEDDING_MODEL=KBLab/sentence-bert-swedish-cased
